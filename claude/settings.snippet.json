{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["~/.claude/cc-quota-guard/scripts/quota_gate.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["~/.claude/cc-quota-guard/scripts/quota_gate.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["~/.claude/cc-quota-guard/scripts/quota_gate.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["~/.claude/cc-quota-guard/scripts/quota_gate.py"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
